{
  "dependencies": {
    "@nestjs/mapped-types": "*",
    "dayjs": "^1.11.13",
    "openai": "^4.95.0"
  },
  "name": "home-buddy-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "docs:dev": "cd apps/docs && yarn start",
    "docs:build": "cd apps/docs && yarn build",
    "docs:serve": "cd apps/docs && yarn serve",
    "docs:clear": "cd apps/docs && yarn clear"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "prettier": "^3.4.2",
    "turbo": "^2.4.0",
    "typescript": "5.7.3"
  },
  "packageManager": "yarn@4.6.0",
  "engines": {
    "node": ">=18"
  }
}
